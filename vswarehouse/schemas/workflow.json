{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow.json",
  "title": "Workflow Schema",
  "description": "A workflow schema",
  "type": "object",
  "required": [
    "name",
    "stages"
  ],
  "properties": {
    "name": {
      "description": "The name of the workflow",
      "type": "string"
    },
    "description": {
      "description": "The description of the workflow",
      "type": "string"
    },
    "selected_requirements_configuration": {
      "type": "string",
      "description": "The preferred requirements configuration to use for the workflow"
    },
    "requirements_configurations": {
      "type": "array",
      "description": "The configuration to use for agent requirements",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the configuration"
          },
          "description": {
            "type": "string",
            "description": "Description of when to use this configuration"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "stages": {
      "description": "The tasks of the workflow",
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "jsonSchema.json",
        "title": "Workflow Stage",
        "description": "Workflow stage schema",
        "type": "object",
        "required": [
          "name",
          "task_path"
        ],
        "properties": {
          "depends_on": {
            "description": "The ids of the stages that this stage depends on",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "description": "The friendly name of the workflow stage",
            "type": "string"
          },
          "description": {
            "description": "The description of the workflow (supports Markdown)",
            "type": "string"
          },
          "agent_requirements": {
            "type": "object",
            "properties": {
              "agent_profile": {
                "type": "string",
                "description": "A specific agent profile to use for the task (otherwise an agent profile that meets the requirements will be used)"
              },
              "cpu_cores": {
                "type": "number",
                "description": "The number of CPU cores to allocate for the task"
              },
              "scheduler_cpu_cost": {
                "type": "number",
                "description": "The CPU cost to use for scheduling the task. This can be less than cpu_cores if the task is not CPU intensive. If not specified, cpu_cores will be used"
              },
              "memory_gb": {
                "type": "number",
                "description": "The amount of memory in GB to allocate for the task"
              },
              "runtime_limit_seconds": {
                "type": "number",
                "description": "The maximum amount of time in seconds that the task is allowed to run. The task will be killed if it has not completed in this time"
              },
              "name": {
                "type": "string",
                "description": "The name of the this resource profile (otherwise Default will be used)"
              },
              "description": {
                "type": "string",
                "description": "The description of the this resource profile"
              }
            },
            "additionalProperties": false
          },
          "task_path": {
            "type": "string",
            "description": "The task to run"
          },
          "run_step": {
            "type": "string",
            "description": "Whether to run the step in the task or not",
            "enum": [
              "always",
              "optional_default_run",
              "optional_default_skip"
            ]
          },
          "run_on_dependency_failure": {
            "description": "Run this stage even if a dependency stage failed or was canceled. The stage still waits for its dependencies to finish first. Useful for reporting or cleanup stages that should always run regardless of upstream outcome.",
            "type": "boolean"
          },
          "glob_parameter": {
            "type": "object",
            "properties": {
              "label": {
                "description": "The label for the parameter",
                "type": "string"
              },
              "help": {
                "description": "Optional help for the parameter",
                "type": "string"
              },
              "path": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "stage"
                      },
                      "stage": {
                        "description": "The stage that the parameter is derived from",
                        "type": "string"
                      },
                      "parameter": {
                        "description": "The parameter name that the path is derived from",
                        "type": "string"
                      },
                      "parameter_expression": {
                        "description": "An optional expression based on the stage parameters to construct the base path",
                        "type": "string"
                      }
                    },
                    "required": [
                      "stage",
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "directory"
                      },
                      "supports_location_mode": {
                        "description": "The file or directory parameter supports a location with Read Only, No Append or Read Write mode. Read Write is the default and other modes can be opted into if supported.",
                        "type": "string",
                        "enum": [
                          "read_only",
                          "read_write",
                          "no_append"
                        ]
                      },
                      "value": {
                        "description": "The path to the directory",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "glob_ex": {
                "description": "The glob expression to extract the parameter parts from the file path listing",
                "type": "string"
              },
              "continue_if_no_match": {
                "description": "Whether to continue if no files match the glob expression, by default false",
                "type": "boolean"
              },
              "output_parameters": {
                "description": "The output parameters of the stage",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "task_parameter_name": {
                      "description": "The name of the parameter in the task to set",
                      "type": "string"
                    },
                    "expression": {
                      "description": "The expression to create the value from the regex capture groups",
                      "type": "string"
                    }
                  },
                  "required": [
                    "expression",
                    "task_parameter_name"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "output_parameters",
              "path",
              "glob_ex"
            ],
            "additionalProperties": false
          },
          "batch_file_parameter": {
            "type": "object",
            "properties": {
              "label": {
                "description": "Label for the parameter for display in the UI",
                "type": "string"
              },
              "help": {
                "description": "Optional help for the parameter",
                "type": "string"
              },
              "path": {
                "type": "object",
                "properties": {
                  "base_path": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "stage"
                          },
                          "stage": {
                            "description": "The stage that the parameter is derived from",
                            "type": "string"
                          },
                          "parameter": {
                            "description": "The parameter name that the path is derived from",
                            "type": "string"
                          },
                          "parameter_expression": {
                            "description": "An optional expression based on the stage parameters to construct the base path",
                            "type": "string"
                          }
                        },
                        "required": [
                          "stage",
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "directory"
                          },
                          "supports_location_mode": {
                            "description": "The file or directory parameter supports a location with Read Only, No Append or Read Write mode. Read Write is the default and other modes can be opted into if supported.",
                            "type": "string",
                            "enum": [
                              "read_only",
                              "read_write",
                              "no_append"
                            ]
                          },
                          "value": {
                            "description": "The path to the directory",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "file": {
                    "description": "The file path to used for listing files",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "parameter_file": {
            "type": "object",
            "properties": {
              "label": {
                "description": "Label for the parameter for display in the UI",
                "type": "string"
              },
              "help": {
                "description": "Optional help for the parameter",
                "type": "string"
              },
              "path": {
                "type": "object",
                "properties": {
                  "base_path": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "stage"
                          },
                          "stage": {
                            "description": "The stage that the parameter is derived from",
                            "type": "string"
                          },
                          "parameter": {
                            "description": "The parameter name that the path is derived from",
                            "type": "string"
                          },
                          "parameter_expression": {
                            "description": "An optional expression based on the stage parameters to construct the base path",
                            "type": "string"
                          }
                        },
                        "required": [
                          "stage",
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "directory"
                          },
                          "supports_location_mode": {
                            "description": "The file or directory parameter supports a location with Read Only, No Append or Read Write mode. Read Write is the default and other modes can be opted into if supported.",
                            "type": "string",
                            "enum": [
                              "read_only",
                              "read_write",
                              "no_append"
                            ]
                          },
                          "value": {
                            "description": "The path to the directory",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "file": {
                    "description": "The file path to used for listing files",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "retry_count": {
            "description": "The number of times to retry the stage if it fails",
            "type": "integer"
          },
          "task_parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "description": "The name of the parameter used in the task script",
                  "type": "string"
                },
                "group": {
                  "description": "The optional group that the parameter belongs to for grouping parameters in the UI",
                  "type": "string"
                },
                "label": {
                  "description": "Label for the parameter for display in the UI",
                  "type": "string"
                },
                "help": {
                  "description": "Optional help for the parameter",
                  "type": "string"
                },
                "type": {
                  "description": "The type of the parameter",
                  "enum": [
                    "string",
                    "float",
                    "integer",
                    "boolean",
                    "enum",
                    "file",
                    "directory",
                    "secret",
                    "stage",
                    "catalog"
                  ]
                },
                "list": {
                  "description": "The parameter is a list",
                  "type": "boolean"
                },
                "create": {
                  "description": "The file parameter is for a file that will be created",
                  "type": "boolean"
                },
                "value": {
                  "description": "The default value of the parameter",
                  "type": [
                    "string",
                    "boolean",
                    "number"
                  ]
                },
                "optional": {
                  "description": "Allow the value to be optional",
                  "type": "boolean"
                },
                "choices": {
                  "description": "The choices of the parameter",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "pattern_match": {
                  "description": "Acceptable file matches for the parameter",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "supports_location_mode": {
                  "description": "The file or directory parameter supports a location with Read Only, No Append or Read Write mode. Read Write is the default and other modes can be opted into if supported.",
                  "type": "string",
                  "enum": [
                    "read_only",
                    "read_write",
                    "no_append"
                  ]
                },
                "path": {
                  "description": "The path used for the file or directory selector. Can be a location or a {variable} between curly braces",
                  "type": "string"
                },
                "editable": {
                  "description": "Allow editing of the parameter",
                  "type": "boolean"
                },
                "stage": {
                  "description": "The stage name to pull the parameter from",
                  "type": "string"
                },
                "stage_parameter": {
                  "description": "The parameter name of the parameter in the stage to use as the value",
                  "type": "string"
                },
                "stage_parameter_expression": {
                  "description": "The expression to use to construct the value from the stage parameters outputs",
                  "type": "string"
                },
                "persist_key": {
                  "description": "The key to use for persisting this parameter value at the workspace level. When provided, the parameter value will be saved and loaded as a default for future workflow runs.",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type",
                "label"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}